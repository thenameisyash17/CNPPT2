    {
      "bbox": [
        645.99609375,
        306.17999267578125,
        820.595947265625,
        325.0799865722656
      ],
      "text": "IP addresses and routing"
    },
    {
      "bbox": [
        48.0,
        381.5871887207031,
        458.1253356933594,
        395.4408874511719
      ],
      "text": "Application data becomes transport segments or datagrams, then IP packets."
    },
    {
      "bbox": [
        930.71484375,
        508.3110046386719,
        944.1548461914062,
