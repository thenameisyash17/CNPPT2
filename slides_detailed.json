{
  "slide_1": [
    {
      "bbox": [
        95.98828125,
        111.80709075927734,
        637.2855224609375,
        384.37200927734375
      ],
      "text": "COMPUTER NETWORKS · TRANSPORT LAYER\nTCP AND UDP\nIN COMPUTER \nNETWORKS"
    },
    {
      "bbox": [
        95.98828125,
        412.67999267578125,
        596.9015502929688,
        452.5799865722656
      ],
      "text": "How applications exchange data, and why reliability and latency lead to \ndifferent choices."
    },
    {
      "bbox": [
        95.98828125,
        467.8371887207031,
        387.2540588378906,
        481.6908874511719
      ],
      "text": "Seminar overview · connection, delivery, and trade-offs"
    }
  ],
  "slide_2": [
    {
      "bbox": [
        48.0,
        48.057090759277344,
        721.3855590820312,
        109.02845764160156
      ],
      "text": "01 · THE TRANSPORT LAYER\nThe transport layer connects applications"
    },
    {
      "bbox": [
        48.0,
        146.42999267578125,
        871.7179565429688,
        186.3300018310547
      ],
      "text": "IP moves packets between hosts; the transport layer moves data between applications on those hosts. Port numbers \nidentify the sending and receiving applications. TCP and UDP sit above IP and below application protocols."
    },
    {
      "bbox": [
        69.99609375,
        261.3025817871094,
        206.0003662109375,
        292.7994384765625
      ],
      "text": "Application"
    },
    {
      "bbox": [
        69.99609375,
        306.17999267578125,
        244.2809295654297,
        325.0799865722656
      ],
      "text": "Web, video, games, DNS"
    },
    {
      "bbox": [
        357.99609375,
        261.3025817871094,
        470.27880859375,
        292.7994384765625
      ],
      "text": "Transport"
    },
    {
      "bbox": [
        357.99609375,
        306.17999267578125,
        548.9010620117188,
        346.0799865722656
      ],
      "text": "TCP or UDP\nPorts and delivery behavior"
    },
    {
      "bbox": [
        645.99609375,
        261.3025817871094,
        747.65576171875,
        292.7994384765625
      ],
