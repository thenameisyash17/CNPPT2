    },
    {
      "bbox": [
        48.0,
        332.0871887207031,
        467.3262023925781,
        345.9408874511719
      ],
      "text": "The acknowledgement confirms receipt. If data is missing, TCP can retransmit it."
    },
    {
      "bbox": [
        930.71484375,
        508.3110046386719,
        944.1548461914062,
        522.2025146484375
      ],
      "text": "06"
    }
  ],
  "slide_7": [
    {
      "bbox": [
        0.0,
        24.057090759277344,
        438.87164306640625,
        122.52845764160156
      ],
      "text": "05 · UDP · USER DATAGRAM PROTOCOL\nUDP keeps communication \nlightweight"
    },
    {
      "bbox": [
        0.0,
        159.92999267578125,
        458.3246154785156,
        178.8300018310547
      ],
      "text": "UDP is connectionless: independent datagrams need no session."
    },
    {
      "bbox": [
        0.0,
        194.55259704589844,
        166.5995330810547,
        226.0494384765625
      ],
      "text": "Low overhead"
    },
    {
      "bbox": [
        0.0,
        239.42999267578125,
        351.1946716308594,
        258.3299865722656
      ],
      "text": "Small headers and no handshake mean fast setup."
    },
    {
      "bbox": [
        0.0,
        287.5525817871094,
        277.3567199707031,
        319.0494384765625
      ],
      "text": "Few built-in guarantees"
    },
    {
      "bbox": [
        0.0,
        332.42999267578125,
        416.7746276855469,
        351.3299865722656
      ],
      "text": "UDP does not promise delivery, ordering, or retransmission."
    },
    {
      "bbox": [
        0.0,
        381.3025817871094,
        171.79873657226562,
        412.7994384765625
      ],
      "text": "Online gaming"
    },
    {
      "bbox": [
        0.0,
        426.17999267578125,
        460.0796203613281,
        445.0799865722656
      ],
      "text": "Online gaming favors fresh positions over recovered old updates."
    },
    {
      "bbox": [
        15.01171875,
        508.3110046386719,
        28.45168685913086,
        522.2025146484375
      ],
      "text": "07"
    }
  ],
  "slide_8": [
    {
      "bbox": [
        48.0,
        48.057090759277344,
        782.5867309570312,
        109.02845764160156
      ],
