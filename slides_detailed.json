      ],
      "text": "02"
    }
  ],
  "slide_3": [
    {
      "bbox": [
        48.0,
        169.5570831298828,
        417.2640075683594,
        363.37200927734375
      ],
      "text": "TCP · TRANSMISSION CONTROL PROTOCOL\nRELIABLE\nDELIVERY"
    },
    {
      "bbox": [
        48.0,
        367.1700134277344,
        232.54620361328125,
        381.3659973144531
      ],
      "text": "OV E R H E A D I S T H E T R A D E"
    },
    {
      "bbox": [
        555.984375,
        49.28496170043945,
        899.6763305664062,
        132.27845764160156
      ],
      "text": "TCP trades overhead \nfor reliability"
    },
    {
      "bbox": [
        555.984375,
        168.30259704589844,
        810.6950073242188,
        199.7994384765625
      ],
      "text": "Connection-oriented"
    },
    {
      "bbox": [
        555.984375,
        213.17999267578125,
        900.6632690429688,
        253.8300018310547
      ],
      "text": "TCP establishes a connection before application \ndata flows."
    },
    {
      "bbox": [
        555.984375,
        283.0525817871094,
        801.2965087890625,
        314.5494384765625
      ],
      "text": "Reliable and ordered"
    },
    {
      "bbox": [
        555.984375,
        327.92999267578125,
        880.5187377929688,
        389.5799865722656
      ],
      "text": "Sequence numbers, acknowledgements, and \nretransmission help deliver complete data in \norder."
    },
    {
      "bbox": [
        555.984375,
        419.5525817871094,
        752.7291259765625,
        451.0494384765625
      ],
      "text": "Familiar example"
    },
    {
      "bbox": [
        555.984375,
        464.42999267578125,
        886.4249877929688,
        504.3299865722656
      ],
      "text": "Loading a web page or transferring a file favors \ncorrectness over the smallest possible delay."
    },
    {
      "bbox": [
        930.71484375,
        508.3110046386719,
        944.1548461914062,
        522.2025146484375
      ],
      "text": "03"
    }
  ],
