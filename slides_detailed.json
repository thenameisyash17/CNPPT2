    },
    {
      "bbox": [
        282.38671875,
        340.1700134277344,
        532.64453125,
        354.3659973144531
      ],
      "text": "DATAG R A M 3  →  R O U T E R  ✕ LO ST"
    },
    {
      "bbox": [
        661.98046875,
        240.0570831298828,
        771.3890991210938,
        292.0494384765625
      ],
      "text": "SERVER\nContinue"
    },
